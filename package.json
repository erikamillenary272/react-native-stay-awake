{
  "name": "react-native-stay-awake",
  "version": "1.0.0",
  "description": "Keep the screen awake / prevent the screen from sleeping in React Native. New Architecture TurboModule with useKeepAwake hook, tag-based reference counting, and web Wake Lock support. Replacement for the deprecated react-native-keep-awake.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-stay-awake-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": "./jest/mock.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "jest",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-stay-awake-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "test": "jest",
    "lint": "eslint \"**/*.{js,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "web",
    "keep-awake",
    "keep awake",
    "wake-lock",
    "wakelock",
    "screen",
    "idle-timer",
    "FLAG_KEEP_SCREEN_ON",
    "idleTimerDisabled",
    "turbo-module",
    "new-architecture",
    "expo-keep-awake",
    "react-native-keep-awake",
    "keep-screen-on",
    "prevent-sleep",
    "screen-timeout",
    "insomnia",
    "nosleep",
    "react-native-web",
    "hooks",
    "typescript",
    "tvos",
    "visionos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intellij-Shivam/react-native-stay-awake.git"
  },
  "author": "Shivam Saini <shivam27saini@icloud.com> (https://github.com/intellij-Shivam)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/intellij-Shivam/react-native-stay-awake/issues"
  },
  "homepage": "https://github.com/intellij-Shivam/react-native-stay-awake#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "babel-jest": "^30.5.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "StayAwakeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.stayawake"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "babel-jest",
        {
          "presets": [
            "module:@react-native/babel-preset"
          ]
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/example/"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
